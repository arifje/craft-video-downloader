{% import '_includes/forms' as forms %}

{% if cookiesConfigured %}
    {% set cookieTip = cookiesSavedAt
        ? 'Saved cookies are configured (last saved {date}). New submissions are merged with these cookies.'|t('app', { date: cookiesSavedAt|datetime('short') })
        : 'Saved cookies are configured. New submissions are merged with these cookies.'|t('app') %}
{% elseif settings.resolvedCookieFile %}
    {% set cookieTip = 'No pasted cookies are saved. Legacy Cookies file is configured.'|t('app') %}
{% else %}
    {% set cookieTip = 'No cookies are configured.'|t('app') %}
{% endif %}

{{ forms.textareaField({
    label: 'Cookies'|t('app'),
    instructions: 'Paste a cookies.txt export (Netscape format) or a JSON export from an extension such as Cookie-Editor (maximum 1 MiB). For security the saved contents are never shown again, so this field is always empty after saving. New cookies are added to the saved set. Matching domain, path and name entries are updated; other cookies stay. Leave blank to keep everything unchanged. Pasted cookies take precedence over Cookies file.'|t('app'),
    name: 'cookiePassword',
    value: '',
    rows: 8,
    placeholder: cookiesConfigured ? '••••••••  Saved cookies are kept. Paste cookies here to add or update them.'|t('app') : '# Netscape HTTP Cookie File'|t('app'),
    inputAttributes: { autocomplete: 'off', spellcheck: 'false' },
    tip: cookieTip,
    errors: settings.getErrors('cookieFile'),
}) }}

{% if cookiesConfigured %}
    <div class="field" id="vd-saved-cookies">
        <div class="heading"><label>{{ 'Saved cookies'|t('app') }}</label></div>
        {% if cookiesSummary %}
            <table class="data fullwidth">
                <thead><tr>
                    <th>{{ 'Remove'|t('app') }}</th>
                    <th>{{ 'Domain'|t('app') }}</th>
                    <th>{{ 'Cookies'|t('app') }}</th>
                    <th>{{ 'First expiry'|t('app') }}</th>
                </tr></thead>
                <tbody>
                {% for row in cookiesSummary %}
                    <tr>
                        <td>{{ forms.checkbox({
                            id: 'remove-cookie-domain-' ~ loop.index,
                            name: 'removeCookieDomains[]',
                            value: row.domain,
                            aria: {label: 'Remove cookies for {domain}'|t('app', {domain: row.domain})},
                        }) }}</td>
                        <td><code>{{ row.domain }}</code></td>
                        <td>{{ row.count }}</td>
                        <td>
                            {% if row.expires is null %}{{ 'Session'|t('app') }}
                            {% else %}{{ row.expires|date('short') }}{% if row.expires < now.timestamp %} <span class="error">{{ '(expired)'|t('app') }}</span>{% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="light">{{ 'The saved cookie file could not be read.'|t('app') }}</p>
        {% endif %}
        <p class="light">{{ 'Select domains to remove when saving. Subdomains are separate rows. Cookie names and values are not shown. Removing every domain clears saved cookies and enables the legacy Cookies file fallback. Do not combine removal with adding cookies or Clear saved cookies.'|t('app') }}</p>
    </div>
{% endif %}

{{ forms.checkboxField({
    label: 'Clear saved cookies'|t('app'),
    instructions: 'Remove pasted cookies on Save. The legacy Cookies file will be used if configured. Do not paste cookies while clearing.'|t('app'),
    name: 'clearCookies',
    checked: false,
}) }}
